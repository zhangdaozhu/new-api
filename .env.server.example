TZ=Asia/Shanghai
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true

# MySQL
MYSQL_ROOT_PASSWORD=change-me-mysql
SQL_DSN=root:change-me-mysql@tcp(mysql:3306)/new-api?charset=utf8mb4&parseTime=true&loc=Local

# Redis
REDIS_CONN_STRING=redis://redis:6379/0

# Multi-node deployment should set a fixed strong secret.
SESSION_SECRET=change-me-session
